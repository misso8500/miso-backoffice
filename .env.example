# 서버 전용 설정입니다. .env.local로 복사한 뒤 새로 발급한 인증정보를 입력합니다.
# Vercel 환경 변수는 별도로 등록하며, 변경 후 새로 배포해야 적용됩니다.
# 비밀값이나 접근 허용 목록에 VITE_ 접두사를 붙이지 않습니다.

# Supabase 대시보드 > Connect에서 세션 풀러 연결 문자열을 복사합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
PGSSLMODE=require
# 선택 설정: 미설정 시 연결 수는 로컬에서 5, Vercel에서 1입니다.
# PG_POOL_MAX=5

# Supabase 대시보드 > Project Settings > API에서 같은 프로젝트의 값을 확인합니다.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 업무 API 접근을 허용할 Google 계정 이메일을 쉼표로 구분합니다. 비워두면 모두 거부합니다.
# 서버 전용 값입니다. 이 변수에 VITE_ 접두사를 붙이지 않습니다.
AUTH_ALLOWED_EMAILS=

# 서버 전용 Drive 인증 설정입니다. JSON 키 파일은 저장소 밖에 보관합니다.
# 로컬에서 Drive를 사용하려면 아래 주석을 해제하고 새 키 파일의 절대 경로를 입력합니다.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/drive-reader-key.json
# 선택 설정: 테스트 API와 npm run drive:check 전용 폴더입니다. 업무 서류 폴더 설정과 별개입니다.
# DRIVE_TEST_FOLDER_ID=REPLACE_WITH_TEST_FOLDER_ID

# 선택 설정: 개별 승인할 수급자별 폴더 ID를 쉼표로 구분합니다.
# 수급자 개별 폴더와 상위 폴더 허용 목록이 모두 비어 있으면 서류 조회를 거부합니다.
# 서비스 계정에도 해당 폴더를 공유해야 합니다. VITE_ 접두사를 붙이지 않습니다.
DRIVE_RECIPIENT_FOLDER_IDS=

# Vercel에서는 서비스 계정 JSON 전체를 서버 전용 환경 변수에 입력하고 Sensitive로 설정합니다.
# 이 값은 로컬 키 파일 경로보다 우선합니다. JSON 전체를 추가 따옴표로 감싸지 않습니다.
# GOOGLE_SERVICE_ACCOUNT_JSON={...}

# 수급자 서류 자동 조회. 서비스 계정에 루트 폴더 읽기 권한을 부여합니다.
# 루트 폴더 ID만 입력합니다. 여러 루트는 쉼표로 구분합니다.
DRIVE_RECIPIENT_ROOT_IDS=
# 루트 기준 하위 폴더 이름을 /로 구분합니다. 비워 두면 루트 바로 아래에서 검색합니다.
# 예시 구조: 승인된 루트 > 수급자 관리 > 수급자 서류 > 김미소
# DRIVE_RECIPIENT_LOOKUP_PATH="수급자 관리/수급자 서류"
# 지정한 경로 바로 아래에서 수급자 명부 이름과 일치하는 폴더를 찾습니다.
DRIVE_RECIPIENT_LOOKUP_PATH=

# 상담자 서류: 별도로 승인할 상위 폴더와 개별 폴더가 있으면 설정합니다.
# 주의: 각 값이 비어 있으면 대응하는 수급자 폴더 설정을 대신 사용합니다.
# 빈 값이 상담자 서류 접근 차단을 뜻하지는 않습니다. 폴더 ID만 쉼표로 구분합니다.
DRIVE_PROSPECT_ROOT_IDS=
DRIVE_PROSPECT_FOLDER_IDS=

# 카테고리 생성·수정·삭제를 허용할 개발자 Google 로그인 이메일 (쉼표 구분).
# 비워두면 모든 계정의 카테고리 변경을 차단합니다. 서버 환경에만 설정합니다.
WORK_CATEGORY_ADMIN_EMAILS=

# 공문 서식: 전용 Drive 공유 폴더를 지정합니다. 서버 전용 설정입니다.
# Drive 조회용 서비스 계정에 해당 폴더를 공유합니다. URL 대신 폴더 ID를 입력합니다.
DRIVE_OFFICIAL_TEMPLATE_FOLDER_ID=
# 선택 설정: 추가로 승인할 서식 폴더 또는 상위 폴더 ID를 쉼표로 구분합니다.
DRIVE_OFFICIAL_TEMPLATE_FOLDER_IDS=
DRIVE_OFFICIAL_TEMPLATE_ROOT_IDS=

# 선택 설정: 로컬 API 포트입니다. 기본값은 5174이며 Vercel에는 직접 설정하지 않습니다.
# PORT=5174
# 선택 설정: npm run api:sqlite 실행 시 사용할 로컬 DB 경로입니다. Vercel 운영 DB로 사용하지 않습니다.
# MISO_BACKOFFICE_DB_PATH=/absolute/path/to/miso-backoffice.sqlite

# Google OAuth 클라이언트 ID와 비밀키는 Supabase의 Google 로그인 제공자 설정에 등록합니다.
# GitHub SSH 인증정보와 Vercel의 GitHub 연동 권한은 이 파일 밖에서 설정합니다.
# SUPABASE_JWKS_URL은 현재 코드에서 사용하지 않으므로 제외했습니다.
# VERCEL은 플랫폼이 제공하며, DRIVE_INCLUDE_SUBFOLDERS는 코드 내부에서 설정합니다.

# 직원 서류 전용 Drive 승인 상위 폴더 및 직원별 예외 승인 폴더 ID (쉼표로 구분)
DRIVE_STAFF_ROOT_IDS=
# 루트가 _미소 전산인 경우 DRIVE_STAFF_LOOKUP_PATH="2.요양보호사/요양보호사 정보"
DRIVE_STAFF_LOOKUP_PATH=
DRIVE_STAFF_FOLDER_IDS=
